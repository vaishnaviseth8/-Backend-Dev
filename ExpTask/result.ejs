<%- include("partials/header") %>

<h2>Student Result</h2>

<p>ID: <%= student.id %></p>
<p>Name: <%= student.name %></p>
<p>Marks: <%= student.marks %></p>
<p>Grade: <%= student.grade %></p>

<p>Status:
<% if(student.marks >= 40){ %>
    Pass
<% } else { %>
    Fail
<% } %>
</p>

<a href="/students">Back</a>

